NODE_ENV=development
PORT=4000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DATABASE_URL=postgresql://crm_user:crm@localhost:5432/crm_db?schema=public
JWT_SECRET=development-only-change-this-secret-value-32-chars-min
TRUST_PROXY=false
LOG_LEVEL=debug

# Explicitly allow cookies for local HTTP development.
AUTH_ALLOW_INSECURE_HTTP=true
