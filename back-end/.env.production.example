NODE_ENV=production
PORT=4000
CORS_ORIGINS=https://clientflow.example.com
DATABASE_URL=postgresql://USER:PASSWORD@RDS_ENDPOINT:5432/clientflow_crm?schema=public&sslmode=require
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
TRUST_PROXY=1
LOG_LEVEL=info

# Access tokens: 15 minutes. Refresh sessions: 7 days from login (not sliding).
AUTH_ACCESS_TOKEN_SECONDS=900
AUTH_SESSION_SECONDS=604800
# Secure cookies are the default. Set true only for intentional HTTP deployments.
AUTH_ALLOW_INSECURE_HTTP=false
