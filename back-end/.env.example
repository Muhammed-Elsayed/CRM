NODE_ENV=development
PORT=4000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/clientflow_crm?schema=public
JWT_SECRET=development-only-change-this-secret-value-32-chars-min
TRUST_PROXY=false
LOG_LEVEL=info

# Access tokens: 15 minutes. Refresh sessions: 7 days from login (not sliding).
AUTH_ACCESS_TOKEN_SECONDS=900
AUTH_SESSION_SECONDS=604800
# Secure cookies are the default. Set true only for intentional HTTP deployments.
AUTH_ALLOW_INSECURE_HTTP=true
