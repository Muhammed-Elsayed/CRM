# Listener settings. For containers, set HOST=0.0.0.0.
# Deployment platforms can supply PORT directly through their environment.
HOST=127.0.0.1
PORT=4001

# Optional comma-separated hostnames, without schemes, ports, or paths.
# For deployment, set these to the MCP domain and permitted client origin hosts.
# Example: MCP_ALLOWED_HOSTS=mcp.example.com
# Example: MCP_ALLOWED_ORIGINS=app.example.com
# When blank, the SDK applies its defaults for the selected HOST.
MCP_ALLOWED_HOSTS=
MCP_ALLOWED_ORIGINS=

# Backend origin only; the tool appends /api/companies.
# Required: use your backend's origin in each environment.
BACKEND_BASE_URL=http://127.0.0.1:4000

# Backend account credentials, preferably supplied by deployment secrets.
# MCP logs in lazily, rotates refresh cookies in memory, and re-logs in after expiry.
BACKEND_EMAIL=
BACKEND_PASSWORD=
